# Obtain a key from the OpenCode console and place it only in local .env.
OPENCODE_API_KEY=

# Choose a model ID supported by the endpoint style below.
OPENCODE_MODEL=gpt-5.6-luna

# Shared OpenCode Zen API root. The selected adapter appends the endpoint path.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# One of: responses, chat_completions (call-time override; explicit model routes)
OPENCODE_API_STYLE=responses
